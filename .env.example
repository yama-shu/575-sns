# 575 — 環境変数の雛形
#
# 使い方:
#   cp .env.example .env
#
# .env は **コミットしない**（.gitignore で除外済み）。
# ここに書かれている値は「ローカル開発でそのまま動く」ことだけを目的とした値であり、
# 本番では Kubernetes の Secret / ConfigMap から注入する。
#
# .env が無くても compose.yaml の既定値で `docker compose up` は動く。
# 既定値から変えたい項目だけを .env に書けばよい。

# ---- PostgreSQL ----
# 本番の認証情報をここに書かないこと。
POSTGRES_USER=sns575
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=sns575
# ホスト側に公開するポート。5432 が既に使われている場合に変更する。
POSTGRES_PORT=5432

# ---- api（Go / Echo）----
# ホスト側に公開するポート。
API_PORT=8080
# debug / info / warn / error
API_LOG_LEVEL=debug

# ---- prosody（Python / FastAPI）----
# ホスト側に公開するポート（開発時のみ公開。本番はクラスタ内部からのみ到達可能）。
PROSODY_PORT=8000
PROSODY_LOG_LEVEL=debug
# 使用する SudachiDict（ADR-0003 で core を採用）
PROSODY_SUDACHI_DICT=core

# ---- web（TypeScript / Next.js）----
# ホスト側に公開するポート。
WEB_PORT=3000
